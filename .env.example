# ApplyPilot Environment Variables

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key is required ONLY server-side for automated cron reminder jobs
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Key (for Opportunity URL Extraction & AI Writing Assistant)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# Resend API Key (for deadline email notifications)
# Obtain from Resend dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# The sender email address. For testing, onboarding@resend.dev works with your verified Resend account email.
RESEND_FROM_EMAIL="ApplyPilot <onboarding@resend.dev>"

# Secret key to authenticate cron jobs hitting /api/cron/reminders
CRON_SECRET=your-secure-random-cron-secret-string
